# Cabeceras HTTP (formato de Netlify y Cloudflare Pages).
# En otro hosting (Apache, Nginx, Vercel…) hay que trasladar estas mismas reglas.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://server.arcgisonline.com; connect-src 'self' https://api.emailjs.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# HTML siempre fresco: así un despliegue nuevo se ve al momento.
/*.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache

# JS y CSS no llevan hash en el nombre: caché corta con revalidación.
/js/*
  Cache-Control: public, max-age=3600, must-revalidate
/css/*
  Cache-Control: public, max-age=3600, must-revalidate

# Teselas de satélite (7,7 MB): cambian poco.
/data/*
  Cache-Control: public, max-age=604800
