{$SITE_DOMAIN} {
	encode zstd gzip

	# Future routes go above the site, e.g. the real API from deploy/fullstack:
	# handle /api/* {
	# 	reverse_proxy api:8000
	# }

	# The demo build (single-page app with # routes); unknown paths fall back to index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /sat/* Cache-Control "public, max-age=604800"
		# HTML always fresh, so a new deploy shows at once
		@html path / /*.html
		header @html Cache-Control "no-cache"
	}

	# Security headers, same as the full stack's frontend/Caddyfile. Third parties: Google Fonts, Esri imagery tiles and EmailJS (form sending).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://server.arcgisonline.com; connect-src 'self' https://api.emailjs.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
}
