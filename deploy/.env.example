# Copy to deploy/.env on the server and fill in. Never commit the real .env.
SITE_DOMAIN=example.cabecerastudio.com
# EmailJS (public by design: they end up in the browser). Empty = forms stay simulated.
# Templates: emailjs/equipo.html and emailjs/usuario.html. Limit allowed domains in EmailJS → Account → Security.
EMAILJS_PUBLIC_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_EQUIPO=
EMAILJS_TEMPLATE_USUARIO=
