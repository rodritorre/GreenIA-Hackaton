{
  "name": "cuando-florece",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "build:demo": "tsc -b && vite build --mode demo --base ./",
    "api:types": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
    "export-fixture": "node scripts/export-fixture.mjs ../backend/florece/seed/fixture.json"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "1.9.22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
