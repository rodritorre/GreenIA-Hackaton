# ─── Required ────────────────────────────────────────────────────────────────
# Your domain, already pointing (DNS A/AAAA record) at this server. Caddy gets the HTTPS certificate for it.
DOMAIN=cuandoflorece.example.es
# Email for Let's Encrypt certificate notices
ACME_EMAIL=you@example.es
# Database password: long and random, e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=
# Used to hash client identifiers (photo rate limit): `openssl rand -hex 32`
FLORECE_SECRET_KEY=

# ─── Data sources ────────────────────────────────────────────────────────────
# Free key from https://opendata.aemet.es/centrodedescargas/altaUsuario  (empty = AEMET skipped)
FLORECE_AEMET_API_KEY=

# ─── Email (see docs/DECISIONS.md, D-07) ─────────────────────────────────────
# 'console' = emails are only logged and stored in the admin outbox (no provider, no cost)
FLORECE_EMAIL_BACKEND=console
FLORECE_EMAIL_FROM=Cuándo Florece <avisos@cuandoflorece.example.es>

# ─── Optional ────────────────────────────────────────────────────────────────
FLORECE_TIMEZONE=Europe/Madrid
# Pin "today" for a demo (YYYY-MM-DD). Leave empty in production.
FLORECE_FIXED_TODAY=
